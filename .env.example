# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (PostgreSQL)
# Provide a PostgreSQL connection string (e.g. Supabase, Neon, or local Postgres).
# If left blank, the application automatically uses embedded PGlite (local PostgreSQL in ./data/postgres).
DATABASE_URL=

# Authentication (Supabase Auth or Local Campus Auth)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=super-secure-campus-bid-secret-key-2026

# Storage
STORAGE_PROVIDER=local
# Option: "local" (uses ./uploads) or "supabase" (uses Supabase Storage bucket)
SUPABASE_STORAGE_BUCKET=auction-images

# AI Assistant
# Optional Gemini or OpenAI API Key. If left blank, uses deterministic intelligent campus assistant tool engine.
GEMINI_API_KEY=
